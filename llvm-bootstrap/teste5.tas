; ============================================================
; GERADO POR tradutor.py — NÃO EDITE À MÃO
; fonte: teste5.ll
; convenção: uma palavra de pilha por valor LLVM; sp cresce para baixo
; Fase 2: + mul, icmp, br (if/else e while)
; Fase 3: + alloca [N x T], GEP, load/store por ponteiro, globais
; ============================================================
    .include "/home/guto/tenerura/src/os/lib/abi.inc"
    .org USER_TEXT
_start:
    call main
    mov a2, a1                  ; código de saída = valor de retorno de main
    li a1, SYS_EXIT
    sys

comprimento:
    addi sp, sp, -14
    st lr, 13(sp)
    st a1, 0(sp)
    ld t1, 0(sp)
    st t1, 1(sp)
    li t1, 0
    st t1, 2(sp)
    j L_comprimento__4
L_comprimento__4:
    ld t1, 1(sp)
    st t1, 3(sp)
    ld t1, 2(sp)
    st t1, 4(sp)
    ld t1, 4(sp)
    st t1, 5(sp)
    ld t1, 3(sp)
    ld t2, 5(sp)
    add t1, t1, t2
    st t1, 6(sp)
    ld t1, 6(sp)
    ld t1, 0(t1)
    st t1, 7(sp)
    ld t1, 7(sp)
    st t1, 8(sp)
    ld t1, 8(sp)
    li t2, 0
    cmp t3, t1, t2
    bne t3, zr, L__icmp_comprimento_1
    li t3, 0
    j L__icmp_comprimento_2
L__icmp_comprimento_1:
    li t3, 1
L__icmp_comprimento_2:
    st t3, 9(sp)
    ld t1, 9(sp)
    bnz t1, L_comprimento__12
    j L_comprimento__15
L_comprimento__12:
    ld t1, 2(sp)
    st t1, 10(sp)
    ld t1, 10(sp)
    li t2, 1
    add t3, t1, t2
    st t3, 11(sp)
    ld t1, 11(sp)
    st t1, 2(sp)
    j L_comprimento__4
L_comprimento__15:
    ld t1, 2(sp)
    st t1, 12(sp)
    ld a1, 12(sp)
    ld lr, 13(sp)
    addi sp, sp, 14
    ret

main:
    addi sp, sp, -11
    st lr, 10(sp)
    li t1, 0
    st t1, 0(sp)
    li t1, 9
    la t2, G_tabela + 2
    st t1, 0(t2)
    la a1, G_msg + 2
    call comprimento
    st a1, 2(sp)
    ld t1, 2(sp)
    st t1, 1(sp)
    ld t1, 1(sp)
    st t1, 3(sp)
    ld t1, 3(sp)
    li t2, 100
    mul t3, t1, t2
    st t3, 4(sp)
    la t1, G_tabela + 2
    ld t1, 0(t1)
    st t1, 5(sp)
    ld t1, 5(sp)
    li t2, 10
    mul t3, t1, t2
    st t3, 6(sp)
    ld t1, 4(sp)
    ld t2, 6(sp)
    add t3, t1, t2
    st t3, 7(sp)
    la t1, G_tabela + 3
    ld t1, 0(t1)
    st t1, 8(sp)
    ld t1, 7(sp)
    ld t2, 8(sp)
    add t3, t1, t2
    st t3, 9(sp)
    ld a1, 9(sp)
    ld lr, 10(sp)
    addi sp, sp, 11
    ret

    .data
G_msg:
    .word 72, 101, 108, 108, 111, 0
G_tabela:
    .word 1, 2, 3, 4

