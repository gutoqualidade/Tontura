    .include "/home/guto/tenerura/src/os/lib/abi.inc"
    .org USER_TEXT
_start:
    call main
    mov a2, a1                  ; código de saída = valor de retorno de main
    li a1, SYS_EXIT
    sys

main:
    addi sp, sp, -20
    st lr, 19(sp)
    li t1, 0
    st t1, 0(sp)
    addi t1, sp, 1
    st t1, 5(sp)
    li t1, 10
    ld t2, 5(sp)
    st t1, 0(t2)
    addi t1, sp, 1
    addi t1, t1, 1
    st t1, 6(sp)
    li t1, 20
    ld t2, 6(sp)
    st t1, 0(t2)
    addi t1, sp, 1
    addi t1, t1, 2
    st t1, 7(sp)
    li t1, 30
    ld t2, 7(sp)
    st t1, 0(t2)
    addi t1, sp, 1
    st t1, 8(sp)
    ld t1, 8(sp)
    ld t1, 0(t1)
    st t1, 9(sp)
    addi t1, sp, 1
    addi t1, t1, 1
    st t1, 10(sp)
    ld t1, 10(sp)
    ld t1, 0(t1)
    st t1, 11(sp)
    ld t1, 9(sp)
    ld t2, 11(sp)
    add t3, t1, t2
    st t3, 12(sp)
    addi t1, sp, 1
    addi t1, t1, 2
    st t1, 13(sp)
    ld t1, 13(sp)
    ld t1, 0(t1)
    st t1, 14(sp)
    ld t1, 12(sp)
    ld t2, 14(sp)
    add t3, t1, t2
    st t3, 15(sp)
    ld t1, 15(sp)
    st t1, 4(sp)
    ld t1, 4(sp)
    st t1, 16(sp)
    ld t1, 16(sp)
    li t2, 60
    cmp t3, t1, t2
    beq t3, zr, L__icmp_main_1
    li t3, 0
    j L__icmp_main_2
L__icmp_main_1:
    li t3, 1
L__icmp_main_2:
    st t3, 17(sp)
    ld t1, 17(sp)
    bnz t1, L_main__17
    j L_main__18
L_main__17:
    li t1, 42
    st t1, 0(sp)
    j L_main__19
L_main__18:
    li t1, 0
    st t1, 0(sp)
    j L_main__19
L_main__19:
    ld t1, 0(sp)
    st t1, 18(sp)
    ld a1, 18(sp)
    ld lr, 19(sp)
    addi sp, sp, 20
    ret

