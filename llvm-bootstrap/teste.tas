; ============================================================
; GERADO POR tradutor.py — NÃO EDITE À MÃO
; fonte: teste.ll
; convenção: uma palavra de pilha por valor LLVM; sp cresce para baixo
; Fase 2: + mul, icmp, br (if/else e while)
; ============================================================
    .include "/home/guto/tenerura/src/os/lib/abi.inc"
    .org USER_TEXT
_start:
    call main
    mov a2, a1                  ; código de saída = valor de retorno de main
    li a1, SYS_EXIT
    sys

multiplica:
    addi sp, sp, -14
    st lr, 13(sp)
    st a1, 0(sp)
    st a2, 1(sp)
    ld t1, 0(sp)
    st t1, 2(sp)
    ld t1, 1(sp)
    st t1, 3(sp)
    li t1, 0
    st t1, 4(sp)
    j L_multiplica__6
L_multiplica__6:
    ld t1, 3(sp)
    st t1, 5(sp)
    ld t1, 5(sp)
    li t2, 0
    cmp t3, t1, t2
    bgt t3, zr, L__icmp_multiplica_1
    li t3, 0
    j L__icmp_multiplica_2
L__icmp_multiplica_1:
    li t3, 1
L__icmp_multiplica_2:
    st t3, 6(sp)
    ld t1, 6(sp)
    bnz t1, L_multiplica__9
    j L_multiplica__15
L_multiplica__9:
    ld t1, 4(sp)
    st t1, 7(sp)
    ld t1, 2(sp)
    st t1, 8(sp)
    ld t1, 7(sp)
    ld t2, 8(sp)
    add t3, t1, t2
    st t3, 9(sp)
    ld t1, 9(sp)
    st t1, 4(sp)
    ld t1, 3(sp)
    st t1, 10(sp)
    ld t1, 10(sp)
    li t2, 1
    sub t3, t1, t2
    st t3, 11(sp)
    ld t1, 11(sp)
    st t1, 3(sp)
    j L_multiplica__6
L_multiplica__15:
    ld t1, 4(sp)
    st t1, 12(sp)
    ld a1, 12(sp)
    ld lr, 13(sp)
    addi sp, sp, 14
    ret

main:
    addi sp, sp, -11
    st lr, 10(sp)
    li t1, 0
    st t1, 0(sp)
    li t1, 4
    st t1, 1(sp)
    li t1, 3
    st t1, 2(sp)
    ld t1, 1(sp)
    st t1, 4(sp)
    ld t1, 2(sp)
    st t1, 5(sp)
    ld a1, 4(sp)
    ld a2, 5(sp)
    call multiplica
    st a1, 6(sp)
    ld t1, 6(sp)
    st t1, 3(sp)
    ld t1, 3(sp)
    st t1, 7(sp)
    ld t1, 7(sp)
    li t2, 12
    cmp t3, t1, t2
    beq t3, zr, L__icmp_main_1
    li t3, 0
    j L__icmp_main_2
L__icmp_main_1:
    li t3, 1
L__icmp_main_2:
    st t3, 8(sp)
    ld t1, 8(sp)
    bnz t1, L_main__10
    j L_main__11
L_main__10:
    li t1, 42
    st t1, 0(sp)
    j L_main__12
L_main__11:
    li t1, 0
    st t1, 0(sp)
    j L_main__12
L_main__12:
    ld t1, 0(sp)
    st t1, 9(sp)
    ld a1, 9(sp)
    ld lr, 10(sp)
    addi sp, sp, 11
    ret

