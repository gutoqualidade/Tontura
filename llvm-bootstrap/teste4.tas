    st t3, 32(sp)
    ld t1, 9(sp)
    st t1, 33(sp)
    ld t1, 32(sp)
    ld t2, 33(sp)
    add t3, t1, t2
    st t3, 34(sp)
    ld a1, 34(sp)
    ld lr, 35(sp)
