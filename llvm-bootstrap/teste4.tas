    j L_main__19
L_main__11:
    ld t1, 5(sp)
    st t1, 12(sp)
    ld t1, 12(sp)
    li t2, 3
    mul t3, t1, t2
    st t3, 13(sp)
    ld t1, 5(sp)
    st t1, 14(sp)
    ld t1, 14(sp)
    st t1, 15(sp)
    addi t1, sp, 1
    ld t2, 15(sp)
    add t1, t1, t2
    st t1, 16(sp)
    ld t1, 13(sp)
    ld t2, 16(sp)
    st t1, 0(t2)
    ld t1, 5(sp)
    st t1, 17(sp)
