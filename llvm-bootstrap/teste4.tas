    ld t1, 3(sp)
    st t1, 7(sp)
    ld t1, 6(sp)
    ld t2, 7(sp)
    cmp t3, t1, t2
    blt t3, zr, L__icmp_soma_1
    li t3, 0
    j L__icmp_soma_2
L__icmp_soma_1:
    li t3, 1
L__icmp_soma_2:
    st t3, 8(sp)
    ld t1, 8(sp)
    bnz t1, L_soma__11
    j L_soma__21
L_soma__11:
    ld t1, 4(sp)
    st t1, 9(sp)
    ld t1, 2(sp)
    st t1, 10(sp)
    ld t1, 5(sp)
    st t1, 11(sp)
    ld t1, 11(sp)
    st t1, 12(sp)
    ld t1, 10(sp)
    ld t2, 12(sp)
    add t1, t1, t2
    st t1, 13(sp)
    ld t1, 13(sp)
    ld t1, 0(t1)
    st t1, 14(sp)
    ld t1, 9(sp)
    ld t2, 14(sp)
    add t3, t1, t2
    st t3, 15(sp)
    ld t1, 15(sp)
    st t1, 4(sp)
    ld t1, 5(sp)
    st t1, 16(sp)
    ld t1, 16(sp)
    li t2, 1
    add t3, t1, t2
    st t3, 17(sp)
    ld t1, 17(sp)
    st t1, 5(sp)
    j L_soma__7
L_soma__21:
    ld t1, 4(sp)
    st t1, 18(sp)
    ld a1, 18(sp)
    ld lr, 19(sp)
    addi sp, sp, 20
    ret

main:
    addi sp, sp, -36
    st lr, 35(sp)
    li t1, 0
    st t1, 0(sp)
    li t1, 0
    st t1, 5(sp)
    j L_main__8
L_main__8:
    ld t1, 5(sp)
    st t1, 10(sp)
    ld t1, 10(sp)
    li t2, 4
    cmp t3, t1, t2
    blt t3, zr, L__icmp_main_1
    li t3, 0
