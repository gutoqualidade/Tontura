    li t2, 1
    add t3, t1, t2
    st t3, 11(sp)
    ld t1, 11(sp)
    st t1, 2(sp)
    j L_comprimento__4
L_comprimento__15:
    ld t1, 2(sp)
    st t1, 12(sp)
    ld a1, 12(sp)
    ld lr, 13(sp)
    addi sp, sp, 14
    ret

soma:
    addi sp, sp, -20
    st lr, 19(sp)
    st a1, 0(sp)
    st a2, 1(sp)
    ld t1, 0(sp)
    st t1, 2(sp)
    ld t1, 1(sp)
    st t1, 3(sp)
    li t1, 0
    st t1, 4(sp)
    li t1, 0
