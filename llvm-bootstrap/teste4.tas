; ============================================================
    .include "/home/guto/tenerura/src/os/lib/abi.inc"
    .org USER_TEXT
_start:
    call main
    mov a2, a1                  ; código de saída = valor de retorno de main
    li a1, SYS_EXIT
    sys

comprimento:
    addi sp, sp, -14
    st lr, 13(sp)
    st a1, 0(sp)
    ld t1, 0(sp)
    st t1, 1(sp)
    li t1, 0
    st t1, 2(sp)
    j L_comprimento__4
L_comprimento__4:
    ld t1, 1(sp)
    st t1, 3(sp)
    ld t1, 2(sp)
    st t1, 4(sp)
    ld t1, 4(sp)
    st t1, 5(sp)
    ld t1, 3(sp)
    ld t2, 5(sp)
    add t1, t1, t2
    st t1, 6(sp)
    ld t1, 6(sp)
    ld t1, 0(t1)
    st t1, 7(sp)
    ld t1, 7(sp)
    st t1, 8(sp)
    ld t1, 8(sp)
    li t2, 0
    cmp t3, t1, t2
    bne t3, zr, L__icmp_comprimento_1
