cabal-version: 2.4
name:           tenerura
version:        0.1.0.0
build-type:     Simple

library
  hs-source-dirs:  src
  exposed-modules: Trit, BT, TernArith, TernLogic
  build-depends:   base >=4.14 && <5
  default-language: Haskell2010
  ghc-options:     -Wall

test-suite tenerura-test
  type:           exitcode-stdio-1.0
  main-is:        Properties.hs
  hs-source-dirs: test
  build-depends:  base, tenerura, QuickCheck
  default-language: Haskell2010
  ghc-options:    -Wall
